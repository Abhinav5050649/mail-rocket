{
  "name": "server",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "bun index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "build": "bun build index.ts --bundle --minify --target=bun --external bullmq --external ioredis --external @aws-sdk/client-ses --external pino --external pino-roll --outfile dist/index.js",
    "test": "bun test tests/controllers",
    "test:send-flows": "bun test tests/services",
    "test:all": "bun test tests"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.11.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1116.0",
    "bullmq": "^6.2.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.12.23",
    "ioredis": "^6.0.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0"
  }
}
