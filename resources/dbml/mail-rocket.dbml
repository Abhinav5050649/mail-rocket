Project mail_rocket {
  database_type: 'PostgreSQL'
  Note: '''
    Mail Rocket relational schema, mirroring the Drizzle table definitions
    in `src/models/*.ts`. Self-hosted and single-organization: there are no
    tenants and no users. `organization` is one seeded row (the instance's
    profile), referenced only by `address` and `contact_details`. `api_key`
    is the only principal; its `claims` decide what it may do.
  '''
}

Enum identity_type {
  domain
  email
}

Enum identity_status {
  created [note: 'Unused: nothing sets it - identities are inserted as pending.']
  pending [note: 'Registered with SES; waiting for it to confirm ownership (DNS records for a domain, a confirmation email for an address).']
  active [note: 'Verified by SES. Only active identities can send.']
}

Enum campaign_status {
  draft [note: 'No send scheduled.']
  scheduled [note: 'A send job is queued for start_time.']
  sending [note: 'The send job fired; recipient chunks are in flight.']
  sent [note: 'Every chunk settled and at least one recipient was sent to.']
  failed [note: 'Nobody was sent to, or the send could not start. See campaign.failure_reason.']
}

Enum campaign_recipient_send_status {
  pending [note: 'Queued in this send, not attempted yet.']
  sent [note: 'SES accepted the email.']
  failed [note: 'SES rejected it, the recipient has no email, or a template variable could not be resolved (see description).']
}

Table organization {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.organization', note: 'Denotes the type of object and the domain it belongs to.']
  name varchar
  normalized_name varchar
  timezone varchar [not null, default: 'UTC', note: 'IANA time zone: dates are shown, start times entered and {{campaign_start_date}} rendered in it']
  created_at timestamp
  updated_at timestamp
  description varchar [note: 'Extra information about the record.']

  Note: '''
    The profile of the organization running this instance. Exactly one row,
    seeded at boot; read/updated via `/organization`, never created or
    deleted over the API.
  '''
}

Table api_key {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.api_key']
  name varchar [not null, note: 'Display label; not unique.']
  claims jsonb [not null, note: 'CASL { action, subject } grants. Closed lists - no wildcards, conditions or inverted rules.']
  key_hash varchar [not null, unique, note: 'SHA-256 hex of the secret. The secret itself is never stored.']
  prefix varchar [not null, note: 'First characters of the secret, for recognising a key in lists.']
  expires_at timestamp [note: 'Null = never expires.']
  created_at timestamp
  updated_at timestamp
  description varchar

  Note: '''
    An API key - the only principal. Authentication is one indexed lookup
    on key_hash. Revoking is a real delete. Nothing references this table:
    resources don't record which key created them.
  '''
}

Table identity {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.identity']
  type identity_type [not null, note: 'Whether this identity is a domain or an email address. Fixed after creation.']
  identity varchar [not null, note: 'The domain name or email address being identified. Fixed after creation - SES verified this exact value.']
  status identity_status [default: 'pending', note: 'System-managed: set by SES verification, rejected (400) if a client sends it.']
  verification_records jsonb [note: 'System-managed: DNS records (TXT + DKIM CNAMEs) SES returned for a domain identity; null for email identities.']
  created_at timestamp
  updated_at timestamp
  description varchar

  Note: 'A domain or email address campaigns send from.'
}

Table address {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.address']
  created_at timestamp
  updated_at timestamp
  description varchar
  street varchar
  area varchar
  city varchar
  state varchar
  country varchar
  postal_code varchar
  is_primary boolean [default: true, note: 'Whether this is the primary address of the organization.']
  organization_id varchar [ref: > organization.id, note: 'Always the single organization row.']

  indexes {
    organization_id [name: 'address_organization_id_idx']
  }
}

Table contact_details {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.contact_details']
  email_id varchar
  country_code varchar
  phone_number varchar
  created_at timestamp
  updated_at timestamp
  description varchar
  organization_id varchar [ref: > organization.id, note: 'Always the single organization row.']

  indexes {
    organization_id [name: 'contact_details_organization_id_idx']
  }

  Note: 'Email/phone the organization can be reached at.'
}

Table campaign {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.campaign']
  name varchar
  subject varchar [note: 'Subject line of the campaign email.']
  logo_key varchar [note: 'Storage key/path of the campaign logo.']
  logo_bucket varchar [note: 'Storage bucket where the campaign logo is stored.']
  created_at timestamp
  updated_at timestamp
  description varchar
  start_time timestamp [note: 'When the send runs. Setting it schedules the send; clearing it (null) cancels a scheduled one.']
  normalized_name varchar
  status campaign_status [default: 'draft', note: 'System-managed: driven by start_time and the send pipeline, rejected (400) if a client sends it.']
  identity_id varchar [ref: > identity.id, note: 'Sending identity (SES From address) for this campaign.']
  failure_reason varchar [note: 'System-managed: why the send ended in `failed`, set by the send pipeline.']

  Note: 'An email campaign.'
}

Table template {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.template']
  name varchar
  html_body varchar [note: 'HTML markup of the email body.']
  campaign_id varchar [ref: > campaign.id]
  normalized_name varchar
  created_at timestamp
  updated_at timestamp
  description varchar

  indexes {
    campaign_id [name: 'template_campaign_id_idx']
  }

  Note: '''
    Reusable HTML content for a campaign email. Subject/name for the send
    itself live on `campaign` - a template only carries the body markup, so
    a campaign can hold several template rows (draft revisions, A/B
    variants) without duplicating campaign-level metadata.
  '''
}

Table "group" {
  id varchar [pk, note: 'UUID']
  created_at timestamp
  updated_at timestamp
  description varchar
  entity varchar [default: 'mail_rocket.group']
  name varchar
  campaign_id varchar [ref: > campaign.id]
  normalized_name varchar

  indexes {
    campaign_id [name: 'group_campaign_id_idx']
  }

  Note: 'A recipient list within a campaign.'
}

Table recipients {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.recipients']
  first_name varchar
  last_name varchar
  normalized_name varchar
  email_id varchar
  campaign_id varchar [ref: > campaign.id, note: 'Linked directly; also reached through groups linked to a campaign']
  created_at timestamp
  updated_at timestamp
  description varchar

  indexes {
    campaign_id [name: 'recipients_campaign_id_idx']
  }

  Note: 'A person a campaign can send to. In any number of groups via group_recipient.'
}

Table group_recipient {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.group_recipient']
  group_id varchar [not null, ref: > "group".id, note: 'ON DELETE CASCADE']
  recipient_id varchar [not null, ref: > recipients.id, note: 'ON DELETE CASCADE']
  created_at timestamp
  updated_at timestamp
  description varchar

  indexes {
    (group_id, recipient_id) [unique, name: 'group_recipient_group_id_recipient_id_unique']
    recipient_id [name: 'group_recipient_recipient_id_idx']
  }

  Note: 'Which recipients are in which groups (many-to-many).'
}

Table campaign_recipient {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.campaign_recipient']
  campaign_id varchar [ref: > campaign.id]
  recipient_id varchar [ref: > recipients.id]
  send_status campaign_recipient_send_status [default: 'pending']
  sent_at timestamp
  created_at timestamp
  updated_at timestamp
  description varchar

  indexes {
    campaign_id [name: 'campaign_recipient_campaign_id_idx']
    recipient_id [name: 'campaign_recipient_recipient_id_idx']
    (campaign_id, send_status) [name: 'campaign_recipient_campaign_id_send_status_idx']
  }

  Note: '''
    Tracks one recipient's send outcome within one campaign's send. Created
    by the dispatch job (one row per recipient, per send) rather than by
    users - kept separate from `recipients` so a recipient row stays freely
    reusable across campaigns instead of carrying send state for whichever
    campaign sent to it most recently.
  '''
}
