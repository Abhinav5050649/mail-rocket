LOG_LEVEL=info
NODE_ENV=local
PORT=3000
# For local (non-Docker) dev, DB_URL points straight at a Postgres instance
# on localhost. Under `docker compose up`, this value is ignored - the api
# service overrides DB_URL to point at the "postgres" container instead
# (see docker-compose.yml), built from the POSTGRES_* vars below.
DB_URL=postgres://postgres:postgres@localhost:5432/mail-rocket
JWT_SECRET=your_jwt_secret

# Credentials for the "postgres" container in docker-compose.yml. Only used
# when running via Docker Compose - irrelevant for local (non-Docker) dev.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mail-rocket

# Redis backs BullMQ (campaign scheduling/send queues). For local (non-Docker)
# dev this points straight at localhost; under `docker compose up` the api
# service overrides this to point at the "redis" container instead.
REDIS_URL=redis://localhost:6379

# AWS SES - used to actually send campaign emails. AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY are read directly by the AWS SDK's default credential
# provider chain, not by our own config - only AWS_REGION is read by config.ts.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# Emails/second the send-chunk worker is throttled to - tune to the account's
# real SES send-rate quota (SES console).
SES_SEND_RATE_PER_SECOND=14