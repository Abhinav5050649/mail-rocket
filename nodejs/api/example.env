LOG_LEVEL=info
NODE_ENV=local
PORT=3000
# In production, use Neon's pooled connection string (the host with the
# "-pooler" suffix, from the Neon dashboard) so the app's own `pg` pool sits
# behind PgBouncer instead of holding direct connections to Postgres.
DB_URL=postgres://postgres:postgres@localhost:5432/mail-rocket
JWT_SECRET=your_jwt_secret