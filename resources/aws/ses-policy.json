{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MailRocketSesIdentityVerification",
      "Effect": "Allow",
      "Action": [
        "ses:VerifyEmailIdentity",
        "ses:VerifyDomainIdentity",
        "ses:VerifyDomainDkim",
        "ses:GetIdentityVerificationAttributes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MailRocketSesSendEmail",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail"
      ],
      "Resource": "arn:aws:ses:*:<AWS_ACCOUNT_ID>:identity/*"
    }
  ]
}
