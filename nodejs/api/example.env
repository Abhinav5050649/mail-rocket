LOG_LEVEL=info
NODE_ENV=local
PORT=3000
# For local (non-Docker) dev, DB_URL points straight at a Postgres instance
# on localhost. Under `docker compose up`, this value is ignored - the api
# service overrides DB_URL to point at the "postgres" container instead
# (see docker-compose.yml), built from the POSTGRES_* vars below.
DB_URL=postgres://postgres:postgres@localhost:5432/mail-rocket
JWT_SECRET=your_jwt_secret

# Credentials for the "postgres" container in docker-compose.yml. Only used
# when running via Docker Compose - irrelevant for local (non-Docker) dev.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mail-rocket