{
  "name": "server",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "node --experimental-strip-types index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "build": "esbuild index.ts --bundle --platform=node --target=node24 --format=esm --banner:js=\"import{createRequire}from 'module';const require=createRequire(import.meta.url);\" --outfile=dist/index.mjs"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "latest",
    "@types/pg": "^8.11.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.4",
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.12.23",
    "pg": "^8.13.0",
    "pino": "^10.3.1"
  }
}
