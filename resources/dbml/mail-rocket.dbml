Project mail_rocket {
  database_type: 'PostgreSQL'
  Note: '''
    Mail Rocket relational schema, mirroring the Drizzle table definitions
    in `src/models/*.ts`. Self-hosted and single-organization: there are no
    tenants and no users. `organization` is one seeded row (the instance's
    profile), referenced only by `address` and `contact_details`. `api_key`
    is the only principal; its `claims` decide what it may do.
  '''
}

Enum identity_type {
  domain
  email
}

Enum identity_status {
  created [note: 'Unused: nothing sets it - identities are inserted as pending.']
  pending [note: 'Registered with SES; waiting for it to confirm ownership (DNS records for a domain, a confirmation email for an address).']
  active [note: 'Verified by SES. Only active identities can send.']
}

Enum campaign_status {
  draft [note: 'No send scheduled.']
  scheduled [note: 'A send job is queued for start_time.']
  sending [note: 'The send job fired; subscriber chunks are in flight.']
  sent [note: 'Every chunk settled and at least one subscriber was sent to.']
  failed [note: 'Nobody was sent to, or the send could not start. See campaign.failure_reason.']
}

Enum campaign_delivery_status {
  pending [note: 'Queued in this send, not attempted yet.']
  sent [note: 'SES accepted the email.']
  failed [note: 'SES rejected it, the subscriber has no email, or a template variable could not be resolved (see description).']
}

Table organization {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.organization', note: 'Denotes the type of object and the domain it belongs to.']
  name varchar
  normalized_name varchar
  timezone varchar [not null, default: 'UTC', note: 'IANA time zone: dates are shown, start times entered and {{campaign_start_date}} rendered in it']
  created_at timestamp
  updated_at timestamp
  description varchar [note: 'Extra information about the record.']

  Note: '''
    The profile of the organization running this instance. Exactly one row,
    seeded at boot; read/updated via `/organization`, never created or
    deleted over the API.
  '''
}

Table api_key {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.api_key']
  name varchar [not null, note: 'Display label; not unique.']
  claims jsonb [not null, note: 'CASL { action, subject } grants. Closed lists - no wildcards, conditions or inverted rules.']
  key_hash varchar [not null, unique, note: 'SHA-256 hex of the secret. The secret itself is never stored.']
  prefix varchar [not null, note: 'First characters of the secret, for recognising a key in lists.']
  expires_at timestamp [note: 'Null = never expires.']
  created_at timestamp
  updated_at timestamp
  description varchar

  Note: '''
    An API key - the only principal. Authentication is one indexed lookup
    on key_hash. Revoking is a real delete. Nothing references this table:
    resources don't record which key created them.
  '''
}

Table identity {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.identity']
  type identity_type [not null, note: 'Whether this identity is a domain or an email address. Fixed after creation.']
  identity varchar [not null, note: 'The domain name or email address being identified. Fixed after creation - SES verified this exact value.']
  status identity_status [default: 'pending', note: 'System-managed: set by SES verification, rejected (400) if a client sends it.']
  verification_records jsonb [note: 'System-managed: DNS records (TXT + DKIM CNAMEs) SES returned for a domain identity; null for email identities.']
  created_at timestamp
  updated_at timestamp
  description varchar

  Note: 'A domain or email address campaigns send from.'
}

Table address {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.address']
  created_at timestamp
  updated_at timestamp
  description varchar
  street varchar
  area varchar
  city varchar
  state varchar
  country varchar
  postal_code varchar
  is_primary boolean [default: true, note: 'Whether this is the primary address of the organization.']
  organization_id varchar [ref: > organization.id, note: 'Always the single organization row.']

  indexes {
    organization_id [name: 'address_organization_id_idx']
  }
}

Table contact_details {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.contact_details']
  email_id varchar
  country_code varchar
  phone_number varchar
  created_at timestamp
  updated_at timestamp
  description varchar
  organization_id varchar [ref: > organization.id, note: 'Always the single organization row.']

  indexes {
    organization_id [name: 'contact_details_organization_id_idx']
  }

  Note: 'Email/phone the organization can be reached at.'
}

Table campaign {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.campaign']
  name varchar
  subject varchar [note: 'Subject line of the campaign email.']
  logo_key varchar [note: 'Storage key/path of the campaign logo.']
  logo_bucket varchar [note: 'Storage bucket where the campaign logo is stored.']
  created_at timestamp
  updated_at timestamp
  description varchar
  start_time timestamp [note: 'When the send runs. Setting it schedules the send; clearing it (null) cancels a scheduled one.']
  normalized_name varchar
  status campaign_status [default: 'draft', note: 'System-managed: driven by start_time and the send pipeline, rejected (400) if a client sends it.']
  identity_id varchar [ref: > identity.id, note: 'Sending identity (SES From address) for this campaign.']
  from_local_part varchar [note: 'Part before the @ of the From address; required for a domain identity (sends from <from_local_part>@<domain>), null for an email identity (sends from itself).']
  from_name varchar [note: 'Display name inboxes show for the sender, e.g. "Mail Rocket". Null sends the bare address.']
  template_id varchar [ref: > template.id, note: 'The template whose HTML this campaign sends; shared with any number of campaigns. ON DELETE SET NULL. Required to schedule.']
  failure_reason varchar [note: 'System-managed: why the send ended in `failed`, set by the send pipeline.']

  Note: 'An email campaign. It picks one template (template_id) and its audience: groups via campaign_group plus individually picked subscribers via campaign_subscriber.'
}

Table template {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.template']
  name varchar
  html_body varchar [note: 'HTML markup of the email body.']
  normalized_name varchar
  created_at timestamp
  updated_at timestamp
  description varchar

  Note: '''
    A reusable HTML email body in the template library. Campaigns pick one
    with campaign.template_id, and any number can share it. Subject, sender
    and schedule live on the campaign - a template only carries the markup.
  '''
}

Table "group" {
  id varchar [pk, note: 'UUID']
  created_at timestamp
  updated_at timestamp
  description varchar
  entity varchar [default: 'mail_rocket.group']
  name varchar
  normalized_name varchar

  Note: 'A reusable subscriber list. Members via group_subscriber; any number of campaigns can send to it via campaign_group.'
}

Table subscribers {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.subscribers']
  first_name varchar
  last_name varchar
  normalized_name varchar
  email_id varchar
  unsubscribed_at timestamp [note: 'Set by the subscriber via an email unsubscribe link; no campaign sends to them after. Read-only over the API.']
  created_at timestamp
  updated_at timestamp
  description varchar

  Note: 'A person a campaign can send to. In any number of groups via group_subscriber; picked individually by any number of campaigns via campaign_subscriber.'
}

Table group_subscriber {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.group_subscriber']
  group_id varchar [not null, ref: > "group".id, note: 'ON DELETE CASCADE']
  subscriber_id varchar [not null, ref: > subscribers.id, note: 'ON DELETE CASCADE']
  created_at timestamp
  updated_at timestamp
  description varchar

  indexes {
    (group_id, subscriber_id) [unique, name: 'group_subscriber_group_id_subscriber_id_unique']
    subscriber_id [name: 'group_subscriber_subscriber_id_idx']
  }

  Note: 'Which subscribers are in which groups (many-to-many).'
}

Table campaign_group {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.campaign_group']
  campaign_id varchar [not null, ref: > campaign.id, note: 'ON DELETE CASCADE']
  group_id varchar [not null, ref: > "group".id, note: 'ON DELETE CASCADE']
  created_at timestamp
  updated_at timestamp
  description varchar

  indexes {
    (campaign_id, group_id) [unique, name: 'campaign_group_campaign_id_group_id_unique']
    group_id [name: 'campaign_group_group_id_idx']
  }

  Note: 'Which groups a campaign sends to (many-to-many).'
}

Table campaign_subscriber {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.campaign_subscriber']
  campaign_id varchar [not null, ref: > campaign.id, note: 'ON DELETE CASCADE']
  subscriber_id varchar [not null, ref: > subscribers.id, note: 'ON DELETE CASCADE']
  created_at timestamp
  updated_at timestamp
  description varchar

  indexes {
    (campaign_id, subscriber_id) [unique, name: 'campaign_subscriber_campaign_id_subscriber_id_unique']
    subscriber_id [name: 'campaign_subscriber_subscriber_id_idx']
  }

  Note: 'Subscribers a campaign sends to individually, on top of its groups (many-to-many).'
}

Table campaign_delivery {
  id varchar [pk, note: 'UUID']
  entity varchar [default: 'mail_rocket.campaign_delivery']
  campaign_id varchar [ref: > campaign.id]
  subscriber_id varchar [ref: > subscribers.id]
  status campaign_delivery_status [default: 'pending']
  sent_at timestamp
  opened_at timestamp [note: 'First open: tracking pixel loaded or a link clicked (null = not opened, or tracking off).']
  clicked_at timestamp [note: 'First click on a tracked link.']
  unsubscribed_at timestamp [note: 'The subscriber unsubscribed through this email (counted in campaign stats).']
  created_at timestamp
  updated_at timestamp
  description varchar

  indexes {
    campaign_id [name: 'campaign_delivery_campaign_id_idx']
    subscriber_id [name: 'campaign_delivery_subscriber_id_idx']
    (campaign_id, status) [name: 'campaign_delivery_campaign_id_status_idx']
  }

  Note: '''
    Tracks one subscriber's send outcome within one campaign's send. Created
    by the dispatch job (one row per subscriber, per send) rather than by
    users - kept separate from `subscribers` so a subscriber row stays freely
    reusable across campaigns instead of carrying send state for whichever
    campaign sent to it most recently.
  '''
}
