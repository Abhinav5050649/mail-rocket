LOG_LEVEL=info
NODE_ENV=local
PORT=3000
# In production (Lambda), use Neon's pooled connection string (the host with
# the "-pooler" suffix, from the Neon dashboard) so concurrent invocations
# don't compete for Postgres's direct connection limit.
DB_URL=postgres://postgres:postgres@localhost:5432/mail-rocket
JWT_SECRET=your_jwt_secret