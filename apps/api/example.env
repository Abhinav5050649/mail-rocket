LOG_LEVEL=info
NODE_ENV=local
PORT=3000
# For local (non-Docker) dev, DB_URL points straight at a Postgres instance
# on localhost. Under `docker compose up`, this value is ignored - the api
# service overrides DB_URL to point at the "postgres" container instead
# (see the repo-root docker-compose.yml), built from the POSTGRES_* vars below.
DB_URL=postgres://postgres:postgres@localhost:5432/mail-rocket

# Credentials for the "postgres" container in the repo-root docker-compose.yml. Only used
# when running via Docker Compose - irrelevant for local (non-Docker) dev.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mail-rocket

# Redis backs BullMQ (campaign scheduling/send queues). For local (non-Docker)
# dev this points straight at localhost; under `docker compose up` the api
# service overrides this to point at the "redis" container instead.
REDIS_URL=redis://localhost:6379

# AWS SES - used to verify sending identities and send campaign emails.
# AWS_REGION is the region your SES identities live in (read by config.ts).
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are an access key for a dedicated
# IAM user holding only resources/aws/ses-policy.json, read directly by the
# AWS SDK's default credential chain. Use a separate key per server (locked
# to its IP) and for local dev, keep this file chmod 600, and rotate keys now
# and then - see requirements.md. On EC2 you can use an instance role
# instead: then delete these two lines entirely (keys here win over the role).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# Emails/second the send-chunk worker is throttled to - tune to the account's
# real SES send-rate quota (SES console).
SES_SEND_RATE_PER_SECOND=14

# Open/click tracking and unsubscribe. PUBLIC_API_URL is this API's public
# base URL (no trailing slash); when set, sent emails get a tracking pixel,
# links through /track/click and an unsubscribe link (plus List-Unsubscribe
# headers), so it must be reachable from subscribers' mail clients.
# TRACKING_SECRET signs those links (required when PUBLIC_API_URL is set) -
# generate one with `openssl rand -hex 32` and never change it, or links in
# emails already sent stop working. Leave both unset to send emails without
# tracking or an unsubscribe link (local testing only).
PUBLIC_API_URL=
TRACKING_SECRET=

# Domains caddy serves over HTTPS when the whole stack runs in Docker (see the
# repo-root Caddyfile). Each needs a DNS A record pointing at the server, with
# ports 80 and 443 open. Set PUBLIC_API_URL to https://<API_DOMAIN> to match.
# Unset, they default to app.localhost / api.localhost for a local run.
APP_DOMAIN=
API_DOMAIN=

# Docker Hub release the stack runs (abhinav2911/mail-rocket-api and
# abhinav2911/mail-rocket-web), e.g. 0.1.0. Only read by docker compose;
# unset, it uses `latest`. Ignored when building from source with --build.
MAIL_ROCKET_VERSION=
